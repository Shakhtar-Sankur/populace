{
  "name": "populace",
  "version": "0.1.0",
  "description": "A simulated population that uses your app through its real API, so you can test what needs more than one person.",
  "type": "module",
  "bin": {
    "populace": "./src/cli.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./engine": "./src/engine/index.mjs"
  },
  "files": [
    "src",
    "adapters/contract.md",
    "adapters/template.mjs",
    "README.md"
  ],
  "scripts": {
    "doctor": "node src/cli.mjs doctor",
    "test": "node src/selftest.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "simulation",
    "testing",
    "load-testing",
    "multi-user",
    "synthetic-users",
    "qa"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0"
  }
}
