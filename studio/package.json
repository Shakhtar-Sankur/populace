{
  "name": "populace-studio",
  "productName": "Populace Studio",
  "version": "1.0.14",
  "description": "Gigzen Populace — bring a population of simulated users to life against your app, and watch what breaks.",
  "author": "Gigzen Private Limited",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run icon && npm run world && npm run fonts && node build/make-installers.mjs",
    "icon": "node build/make-ico.mjs",
    "world": "node build/make-world.mjs",
    "fonts": "node build/make-fonts.mjs",
    "store-assets": "node build/make-store-assets.mjs",
    "dist:store": "npm run icon && npm run world && npm run fonts && npm run store-assets && node build/make-appx.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "world-atlas": "^2.0.2"
  },
  "build": {
    "appId": "com.gigzen.populace.studio",
    "productName": "Populace Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "populace/src"
      },
      {
        "from": "../adapters",
        "to": "populace/adapters"
      },
      {
        "from": "../examples",
        "to": "populace/examples"
      },
      {
        "from": "../package.json",
        "to": "populace/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PopulaceStudio-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Populace Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PopulaceStudio-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PopulaceStudio-Portable-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Gigzen Private Limited",
    "appx": {
      "identityName": "REPLACE-WITH-PARTNER-CENTER-IDENTITY-NAME",
      "publisher": "CN=REPLACE-WITH-PARTNER-CENTER-PUBLISHER-ID",
      "publisherDisplayName": "Gigzen Private Limited",
      "applicationId": "PopulaceStudio",
      "displayName": "Populace Studio",
      "backgroundColor": "#06080A",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ]
    }
  }
}
