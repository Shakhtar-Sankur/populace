{
  "name": "populace-studio",
  "productName": "Populace Studio",
  "version": "1.0.0",
  "description": "Bring a population of simulated users to life against your app, and watch what breaks.",
  "author": "Gigzen Private Limited",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run icon && electron-builder --win --publish never",
    "dist:portable": "npm run icon && electron-builder --win portable --publish never",
    "icon": "node build/make-ico.mjs"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gigzen.populace.studio",
    "productName": "Populace Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "populace/src"
      },
      {
        "from": "../adapters",
        "to": "populace/adapters"
      },
      {
        "from": "../examples",
        "to": "populace/examples"
      },
      {
        "from": "../package.json",
        "to": "populace/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PopulaceStudio-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Populace Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PopulaceStudio-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PopulaceStudio-Portable-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Gigzen Private Limited"
  }
}
